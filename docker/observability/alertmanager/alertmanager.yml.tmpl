global:
  smtp_smarthost: '__SMTP_SMARTHOST__'
  smtp_from: '__EMAIL_FROM__'
  smtp_auth_username: '__SMTP_USERNAME__'
  smtp_auth_password: '__SMTP_PASSWORD__'
  smtp_require_tls: __SMTP_REQUIRE_TLS__

route:
  receiver: email
  group_by: ['alertname', 'service', 'application', 'queue']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: email
    email_configs:
      - to: '__EMAIL_TO__'
        send_resolved: true
        headers:
          Subject: '[EduConnect] {{ .Status | toUpper }} {{ .CommonLabels.alertname }} ({{ len .Alerts }})'
