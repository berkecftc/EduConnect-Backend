# docker-compose.yml için kimlik bilgileri şablonu.
# Kullanım: bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
# Önemli: POSTGRES_PASSWORD ve RABBITMQ_PASSWORD yalnızca ilgili volume İLK kez
# oluşturulurken uygulanır.
# Servislerin kullandığı parolalar config reposundaki değerlerle aynı olmalıdır.

POSTGRES_USER=eduadmin
POSTGRES_PASSWORD=CHANGE_ME

AUTH_DB_PASSWORD=CHANGE_ME
USER_DB_PASSWORD=CHANGE_ME
CLUB_DB_PASSWORD=CHANGE_ME
EVENT_DB_PASSWORD=CHANGE_ME
COURSE_DB_PASSWORD=CHANGE_ME
ASSIGNMENT_DB_PASSWORD=CHANGE_ME
POST_DB_PASSWORD=CHANGE_ME
GAMIFICATION_DB_PASSWORD=CHANGE_ME

RABBITMQ_USER=educonnect
RABBITMQ_PASSWORD=CHANGE_ME

MINIO_ROOT_USER=educonnect
MINIO_ROOT_PASSWORD=CHANGE_ME_min_8_chars

REDIS_PASSWORD=CHANGE_ME

CONFIG_SERVER_PASSWORD=CHANGE_ME
EUREKA_PASSWORD=CHANGE_ME

ENCRYPT_KEY=CHANGE_ME
CONFIG_GIT_USERNAME=CHANGE_ME
CONFIG_GIT_TOKEN=CHANGE_ME

EDUCONNECT_FRONTEND_URL=http://localhost:5173
EDUCONNECT_API_URL=http://localhost:8080
EDUCONNECT_STORAGE_URL=http://localhost:9000

EDUCONNECT_DOMAIN=localhost
EDUCONNECT_STORAGE_DOMAIN=files.localhost
EDUCONNECT_HSTS=max-age=0
FRONTEND_DIST=./docker/caddy/site
HTTP_PORT=80
HTTPS_PORT=443

OTLP_ENDPOINT=http://tempo:4318/v1/traces

GRAFANA_ADMIN_PASSWORD=CHANGE_ME
ALERT_EMAIL_TO=ops@educonnect.local
ALERT_EMAIL_FROM=alerts@educonnect.local
ALERT_SMTP_SMARTHOST=mailpit:1025
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_REQUIRE_TLS=false

IMAGE_REGISTRY=educonnect
IMAGE_TAG=local
APP_MEM_LIMIT=768m
LLM_MEM_LIMIT=1g
