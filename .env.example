# docker-compose.yml için kimlik bilgileri şablonu.
# Kullanım: bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
# Önemli: POSTGRES_PASSWORD ve RABBITMQ_PASSWORD yalnızca ilgili volume İLK kez
# oluşturulurken uygulanır.
# Servislerin kullandığı parolalar config reposundaki değerlerle aynı olmalıdır.

POSTGRES_USER=eduadmin
POSTGRES_PASSWORD=CHANGE_ME

RABBITMQ_USER=educonnect
RABBITMQ_PASSWORD=CHANGE_ME

MINIO_ROOT_USER=educonnect
MINIO_ROOT_PASSWORD=CHANGE_ME_min_8_chars
